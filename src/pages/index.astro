---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/astro/SiteHeader.astro";
import SiteFooter from "../components/astro/SiteFooter.astro";
import Container from "../components/astro/Container.astro";
import Section from "../components/astro/Section.astro";
export const prerender = true;
---

<BaseLayout title="KCB Labs — Foundation" description="KCB Labs explores ideas that could become technology, products and companies.">
  <SiteHeader />
  <Container>
    <Section>
      <h1>KCB Labs — Foundation Ready</h1>
      <p class="text-body" style="max-width: var(--container-content); color: var(--color-muted);">PBI-001 scaffold: Astro server + React + Keystatic + Node standalone. PBI-002 tokens + PBI-003 layouts.</p>
    </Section>
  </Container>
  <SiteFooter />
</BaseLayout>
