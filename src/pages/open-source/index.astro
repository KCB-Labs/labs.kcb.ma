---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/astro/SiteHeader.astro";
import SiteFooter from "../../components/astro/SiteFooter.astro";
import Container from "../../components/astro/Container.astro";
import PageLayout from "../../components/astro/PageLayout.astro";
import Section from "../../components/astro/Section.astro";
import OpenSourceCard from "../../components/cards/OpenSourceCard.astro";
import { getOpenSource } from "../../lib/content/opensource.js";

export const prerender = true;

const openSourceItems = getOpenSource();
const featured = openSourceItems.filter((o) => o.data.featured === true);
const others = openSourceItems.filter((o) => o.data.featured !== true);
---

<BaseLayout title="Open Source — KCB Labs" description="Open source projects and protocols distributed by KCB Labs.">
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <PageLayout
      crumbs={[{ label: "Open Source" }]}
      title="Open Source"
      description="Open source projects and protocols distributed by KCB Labs. Distribution layer, not a separate R&D stage."
    >
      <Section>
        {featured.length > 0 && (
          <>
            <h2>Featured</h2>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
              {featured.map((o) => (
                <OpenSourceCard slug={o.slug} title={o.data.title as string} description={o.data.description as string} status={o.data.status as string} license={o.data.license as string} originLab={o.data.originLab as string | undefined} />
              ))}
            </div>
          </>
        )}

        {others.length > 0 && (
          <>
            <h2>All Projects</h2>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
              {others.map((o) => (
                <OpenSourceCard slug={o.slug} title={o.data.title as string} description={o.data.description as string} status={o.data.status as string} license={o.data.license as string} originLab={o.data.originLab as string | undefined} />
              ))}
            </div>
          </>
        )}

        {openSourceItems.length === 0 && (
          <p class="text-small" style="color: var(--color-muted);">No open source projects yet.</p>
        )}
      </Section>
    </PageLayout>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>
