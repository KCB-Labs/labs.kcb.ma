---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/astro/SiteHeader.astro";
import SiteFooter from "../../../components/astro/SiteFooter.astro";
import Container from "../../../components/astro/Container.astro";
import SectionLayout from "../../../components/astro/SectionLayout.astro";
import Section from "../../../components/astro/Section.astro";
import RatingDots from "../../../components/ui/RatingDots.astro";
import ExperimentCard from "../../../components/cards/ExperimentCard.astro";
import ProjectCard from "../../../components/cards/ProjectCard.astro";
import ArticleCard from "../../../components/cards/ArticleCard.astro";
import LabCard from "../../../components/cards/LabCard.astro";
import { getResearch, getResearchBySlug } from "../../../lib/content/research.js";
import { getExperimentsByResearch } from "../../../lib/content/experiments.js";
import { getProjectsByResearch } from "../../../lib/content/relationships.js";
import { getArticlesByResearch } from "../../../lib/content/relationships.js";
import { getLabs } from "../../../lib/content/labs.js";

export const prerender = true;

export async function getStaticPaths() {
  const research = getResearch();
  return research.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const item = getResearchBySlug(slug!);
if (!item) {
  return Astro.redirect("/404", 404);
}

const experiments = getExperimentsByResearch(slug!);
const projects = getProjectsByResearch(slug!);
const articles = getArticlesByResearch(slug!);
const labSlug = item.data.lab as string | undefined;
const lab = labSlug ? getLabs().find((l) => l.slug === labSlug) : undefined;
const question = item.data.question as string | undefined;
const hypothesis = item.data.hypothesis as string | undefined;
---

<BaseLayout title={`${item.data.title as string} — KCB Labs Research`} description={item.data.description as string}>
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <SectionLayout
      crumbs={[{ label: "Explore", href: "/explore" }, { label: "Research", href: "/explore/research" }, { label: item.data.title as string }]}
      title={item.data.title as string}
      description={item.data.description as string}
      status={item.data.status as string}
      section="explore"
      currentSlug="research"
    >
      <RatingDots slot="rating" knowledge={item.data.ratingKnowledge as number ?? 1} creativity={item.data.ratingCreativity as number ?? 1} business={item.data.ratingBusiness as number ?? 1} />

      <Section>
        <h2>Overview</h2>
        <p class="text-body">{item.content.slice(0, 600)}</p>
      </Section>

      {question && (
        <Section>
          <h2>Research Question</h2>
          <p class="text-body">{question}</p>
        </Section>
      )}

      {hypothesis && (
        <Section>
          <h2>Hypothesis</h2>
          <p class="text-body">{hypothesis}</p>
        </Section>
      )}

      {lab && (
        <Section>
          <h2>Lab</h2>
          <LabCard slug={lab.slug} title={lab.data.title as string} description={lab.data.description as string} status={lab.data.status as string} />
        </Section>
      )}

      <Section>
        <h2>Experiments</h2>
        {experiments.length > 0 ? (
          <div style="display:grid; gap: var(--space-3);">
            {experiments.map((e) => (
              <ExperimentCard slug={e.slug} title={e.data.title as string} description={e.data.description as string} outcome={e.data.outcome as string | undefined} />
            ))}
          </div>
        ) : <p class="text-small" style="color: var(--color-muted);">No experiments yet.</p>}
      </Section>

      <Section>
        <h2>Projects</h2>
        {projects.length > 0 ? (
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
            {projects.map((p) => (
              <ProjectCard slug={p.slug} title={p.data.title as string} description={p.data.description as string} type={p.data.type as string} stage={p.data.stage as string} originLab={p.data.originLab as string | undefined} />
            ))}
          </div>
        ) : <p class="text-small" style="color: var(--color-muted);">No projects yet.</p>}
      </Section>

      <Section>
        <h2>Related Journal</h2>
        {articles.length > 0 ? (
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
            {articles.map((a) => (
              <ArticleCard slug={a.slug} title={a.data.title as string} description={a.data.description as string} category={a.data.category as string} publishedAt={a.data.publishedAt as string | undefined} readingTime={a.readingTime} />
            ))}
          </div>
        ) : <p class="text-small" style="color: var(--color-muted);">No related articles yet.</p>}
      </Section>
    </SectionLayout>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>
