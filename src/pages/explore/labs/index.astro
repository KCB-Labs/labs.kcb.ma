---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/astro/SiteHeader.astro";
import SiteFooter from "../../../components/astro/SiteFooter.astro";
import Container from "../../../components/astro/Container.astro";
import SectionLayout from "../../../components/astro/SectionLayout.astro";
import Section from "../../../components/astro/Section.astro";
import LabCard from "../../../components/cards/LabCard.astro";
import { LabsFilters } from "../../../components/react/Filters";
import { getLabs } from "../../../lib/content/labs.js";

export const prerender = true;

const labs = getLabs();
---

<BaseLayout title="Labs — KCB Labs" description="Persistent areas of exploration at KCB Labs.">
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <SectionLayout
      crumbs={[{ label: "Explore", href: "/explore" }, { label: "Labs" }]}
      title="Labs"
      description="Persistent areas of exploration — each lab asks what we are continuously investigating."
      section="explore"
      currentSlug="labs"
    >
      <Section>
        <LabsFilters client:visible />
        <div id="labs-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
          {labs.map((lab) => (
            <div class="lab-card-wrapper" data-status={lab.data.status as string}>
              <LabCard slug={lab.slug} title={lab.data.title as string} description={lab.data.description as string} status={lab.data.status as string} />
            </div>
          ))}
        </div>
        {labs.length === 0 && <p class="text-small" style="color: var(--color-muted);">No labs yet.</p>}
      </Section>
    </SectionLayout>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>

<script>
  function applyLabFilters() {
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status");
    const cards = document.querySelectorAll(".lab-card-wrapper");
    cards.forEach((card) => {
      const el = card as HTMLElement;
      const cardStatus = el.dataset.status;
      const visible = !status || cardStatus === status;
      el.style.display = visible ? "" : "none";
    });
  }

  window.addEventListener("filters-changed", applyLabFilters);
  document.addEventListener("DOMContentLoaded", applyLabFilters);
</script>
