---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/astro/SiteHeader.astro";
import SiteFooter from "../../../components/astro/SiteFooter.astro";
import Container from "../../../components/astro/Container.astro";
import PageLayout from "../../../components/astro/PageLayout.astro";
import Section from "../../../components/astro/Section.astro";
import { getVisionPage } from "../../../lib/content/pages.js";

export const prerender = true;

const vision = getVisionPage();
const vTitle = vision?.data?.title ?? "Vision";
const vDesc = vision?.data?.description ?? "Where KCB Labs is headed.";
const vContent = vision?.content ?? "";
---

<BaseLayout title={vTitle} description={vDesc}>
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <PageLayout
      crumbs={[{ label: "About", href: "/about" }, { label: "Vision" }]}
      title={vTitle}
      description={vDesc}
    >
      <Section>
        <p>{vContent || "Vision content placeholder."}</p>
      </Section>
    </PageLayout>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>
