---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/astro/SiteHeader.astro";
import SiteFooter from "../../components/astro/SiteFooter.astro";
import Container from "../../components/astro/Container.astro";
import PageLayout from "../../components/astro/PageLayout.astro";
import Section from "../../components/astro/Section.astro";
import ChildPageCard from "../../components/astro/ChildPageCard.astro";
import { getAboutPage } from "../../lib/content/pages.js";

export const prerender = true;

const about = getAboutPage();
const aTitle = about?.data?.title ?? "About KCB Labs";
const aDesc = about?.data?.description ?? "Who we are and how we work.";
const aContent = about?.content ?? "";
---

<BaseLayout title={aTitle} description={aDesc}>
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <PageLayout
      crumbs={[{ label: "About" }]}
      title={aTitle}
      description={aDesc}
    >
      <Section>
        <p>{aContent || "About KCB Labs content."}</p>
      </Section>

      <Section>
        <div class="child-grid">
          <ChildPageCard href="/about/vision" title="Vision" description="Where KCB Labs is headed — our direction and long-term view." />
          <ChildPageCard href="/about/people" title="People" description="The team and collaborators behind KCB Labs." />
          <ChildPageCard href="/about/ecosystem" title="Ecosystem" description="Partners, clients, sponsors, and organizations we work with." />
          <ChildPageCard href="/about/roadmap" title="Roadmap" description="Upcoming exploration areas and directional timeline." />
        </div>
      </Section>
    </PageLayout>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>

<style>
  .child-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>
