---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/astro/SiteHeader.astro";
import SiteFooter from "../../components/astro/SiteFooter.astro";
import Container from "../../components/astro/Container.astro";
import Section from "../../components/astro/Section.astro";
import PageHeader from "../../components/astro/PageHeader.astro";
import Breadcrumbs from "../../components/astro/Breadcrumbs.astro";
import Prose from "../../components/astro/Prose.astro";
import { getAboutPage } from "../../lib/content/pages.js";

export const prerender = true;

const about = getAboutPage();
---

<BaseLayout title={about?.data?.title as string ?? "About KCB Labs"} description={about?.data?.description as string ?? "Who we are and how we work."}>
  <SiteHeader />
  <Container>
    <Breadcrumbs crumbs={[{ label: "About", href: "/about" }]} />
    <PageHeader label="About" title={about?.data?.title as string ?? "About KCB Labs"} description={about?.data?.description as string ?? "Who we are and how we work."} />

    <Section>
      <Prose>
        <div set:html={about?.content ?? ""} />
      </Prose>
    </Section>

    <Section>
      <h2>Explore</h2>
      <ul style="list-style:none; padding:0; display:grid; gap: var(--space-3);">
        <li><a href="/about/vision" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">Vision — Where we're headed</a></li>
        <li><a href="/about/people" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">People — The team and collaborators</a></li>
        <li><a href="/about/ecosystem" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">Ecosystem — Partners and organizations</a></li>
        <li><a href="/about/roadmap" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">Roadmap — Upcoming exploration areas</a></li>
      </ul>
    </Section>

    <Section>
      <h2>Participate</h2>
      <ul style="list-style:none; padding:0; display:grid; gap: var(--space-3);">
        <li><a href="/participate/sponsorship" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">Sponsorship — Support independent research</a></li>
        <li><a href="/participate/collaboration" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">Collaboration — Work with us</a></li>
        <li><a href="/contact" style="text-decoration:none; padding: var(--space-3); border: var(--border-subtle); border-radius: var(--radius-md); display:block;">Contact — Get in touch</a></li>
      </ul>
    </Section>
  </Container>
  <SiteFooter />
</BaseLayout>