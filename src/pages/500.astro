---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/astro/SiteHeader.astro";
import SiteFooter from "../components/astro/SiteFooter.astro";
import Container from "../components/astro/Container.astro";
import Section from "../components/astro/Section.astro";
---
<BaseLayout title="Server error — KCB Labs" description="Something went wrong on our end." noindex>
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <Section>
      <h1>Something went wrong.</h1>
      <p class="text-body" style="color: var(--color-muted); margin-top: var(--space-3);">We hit an unexpected error. The team has been notified. Try again or head back to explore.</p>
      <div style="display:flex; gap: var(--space-3); margin-top: var(--space-5);">
        <a href="/" style="padding: var(--space-2) var(--space-4); background: var(--color-accent); color: var(--color-accent-contrast); border-radius: var(--radius-md); text-decoration:none;">Home</a>
        <a href="/explore/labs" style="padding: var(--space-2) var(--space-4); border: var(--border-subtle); border-radius: var(--radius-md); text-decoration:none;">Labs</a>
        <a href="/explore/projects" style="padding: var(--space-2) var(--space-4); border: var(--border-subtle); border-radius: var(--radius-md); text-decoration:none;">Projects</a>
      </div>
    </Section>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>
