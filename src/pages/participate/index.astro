---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/astro/SiteHeader.astro";
import SiteFooter from "../../components/astro/SiteFooter.astro";
import Container from "../../components/astro/Container.astro";
import PageLayout from "../../components/astro/PageLayout.astro";
import Section from "../../components/astro/Section.astro";
import ChildPageCard from "../../components/astro/ChildPageCard.astro";
import { getParticipatePage } from "../../lib/content/pages.js";

export const prerender = true;

const participate = getParticipatePage();
const pTitle = participate?.data?.title ?? "Participate";
const pDesc = participate?.data?.description ?? "Support, collaborate, or connect with KCB Labs.";
const pContent = participate?.content ?? "";
---

<BaseLayout title={pTitle} description={pDesc}>
  <Fragment slot="header"><SiteHeader /></Fragment>
  <Container>
    <PageLayout
      crumbs={[{ label: "Participate" }]}
      title={pTitle}
      description={pDesc}
    >
      <Section>
        <p>{pContent || "Participate content."}</p>
      </Section>

      <Section>
        <div class="child-grid">
          <ChildPageCard href="/participate/sponsorship" title="Sponsorship" description="Support independent technology research and experimentation." />
          <ChildPageCard href="/participate/collaboration" title="Collaboration" description="Research, technology, project, or startup partnerships with KCB Labs." />
          <ChildPageCard href="/contact" title="Contact" description="Get in touch with the team." />
        </div>
      </Section>
    </PageLayout>
  </Container>
  <Fragment slot="footer"><SiteFooter /></Fragment>
</BaseLayout>

<style>
  .child-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>
