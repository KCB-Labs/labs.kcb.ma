---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/astro/Container.astro";
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}
const { title, description, canonical, ogImage, ogType = "article", noindex, schema } = Astro.props;
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogType={ogType} noindex={noindex} schema={schema}>
  <Container size="content">
    <slot />
  </Container>
</BaseLayout>
