---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/astro/Container.astro";
import Breadcrumbs from "../components/astro/Breadcrumbs.astro";
interface Props {
  title: string;
  description: string;
  crumbs?: { label: string; href?: string }[];
}
const { title, description, crumbs = [] } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <Container>
    {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <slot />
  </Container>
</BaseLayout>
