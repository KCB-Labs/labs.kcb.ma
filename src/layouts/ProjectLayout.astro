---
import BaseLayout from "./BaseLayout.astro";
import Container from "../components/astro/Container.astro";
import Breadcrumbs from "../components/astro/Breadcrumbs.astro";
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  crumbs?: { label: string; href?: string }[];
}
const { title, description, canonical, ogImage, ogType, noindex, schema, crumbs = [] } = Astro.props;
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogType={ogType} noindex={noindex} schema={schema}>
  <Container>
    {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <slot />
  </Container>
</BaseLayout>
