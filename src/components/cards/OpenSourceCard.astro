---
import StatusBadge from "../ui/StatusBadge.astro";
import RatingDots from "../ui/RatingDots.astro";
interface Props {
  slug: string;
  title: string;
  description: string;
  status: string;
  license: string;
  originLab?: string;
  ratingKnowledge?: number;
  ratingCreativity?: number;
  ratingBusiness?: number;
}
const { slug, title, description, status, license, originLab, ratingKnowledge = 1, ratingCreativity = 1, ratingBusiness = 1 } = Astro.props;
---
<a href={`/explore/open-source/${slug}`} class="card card--opensource">
  <div class="card__meta">
    <StatusBadge status={status} />
    <span class="badge badge--license">{license}</span>
  </div>
  <h3>{title}</h3>
  <p class="card__desc">{description}</p>
  {originLab && <p class="card__origin">{originLab}</p>}
  <div class="card__metrics">
    <RatingDots knowledge={ratingKnowledge} creativity={ratingCreativity} business={ratingBusiness} />
  </div>
</a>

<style>
  .card--opensource {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--opensource:hover {
    border-color: var(--color-text);
  }
  .card__meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .card--opensource h3 {
    font-family: var(--font-mono);
    font-size: 21px;
    font-weight: 800;
    margin: 0;
  }
  .card__desc {
    margin: 0;
    font-size: 14.5px;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .card__origin {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin: 0;
  }
  .badge--license {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    background: transparent;
  }
  .card__metrics {
    margin-top: auto;
  }
</style>
