---
import StatusBadge from "../ui/StatusBadge.astro";
interface Props {
  slug: string;
  title: string;
  description: string;
  status: string;
  license: string;
  originLab?: string;
}
const { slug, title, description, status, license, originLab } = Astro.props;
---
<a href={`/explore/open-source/${slug}`} class="card card--opensource">
  <div class="card__meta">
    <StatusBadge status={status} />
    <span class="badge badge--license">{license}</span>
  </div>
  <h3>{title}</h3>
  <p class="text-small">{description}</p>
  {originLab && <p class="text-metadata">Origin: {originLab}</p>}
</a>

<style>
  .card--opensource {
    display: grid;
    gap: var(--space-3);
    padding: var(--s-gap);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--opensource:hover {
    border-color: var(--color-accent);
  }
  .card__meta {
    display: flex;
    gap: var(--space-2);
  }
  .badge--license {
    font-family: var(--font-mono);
    font-size: var(--text-metadata);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
</style>
