---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt?: string;
  readingTime?: number;
  relatedLab?: string;
}
const { slug, title, description, category, publishedAt, readingTime, relatedLab } = Astro.props;
const date = publishedAt ? new Date(publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "";
---
<a href={`/journal/${slug}`} class="card card--article">
  <p class="card__meta">{category} {date && `· ${date}`} {readingTime && `· ${readingTime} min`}</p>
  <h3>{title}</h3>
  <p class="card__desc">{description}</p>
  {relatedLab && <p class="card__origin">Lab: {relatedLab}</p>}
</a>

<style>
  .card--article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--article:hover {
    border-color: var(--color-text);
  }
  .card__meta {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin: 0;
    text-transform: uppercase;
  }
  .card--article h3 {
    font-family: var(--font-body);
    font-size: 21px;
    font-weight: 800;
    margin: 0;
  }
  .card__desc {
    margin: 0;
    font-size: 14.5px;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .card__origin {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin: 0;
  }
</style>
