---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt?: string;
  readingTime?: number;
  relatedLab?: string;
}
const { slug, title, description, category, publishedAt, readingTime, relatedLab } = Astro.props;
const date = publishedAt ? new Date(publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "";
---
<a href={`/journal/${slug}`} class="card card--article">
  <p class="text-metadata">{category} {date && `· ${date}`} {readingTime && `· ${readingTime} min`}</p>
  <h3>{title}</h3>
  <p class="text-small">{description}</p>
  {relatedLab && <p class="text-metadata">Lab: {relatedLab}</p>}
</a>

<style>
  .card--article {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .card--article:hover {
    box-shadow: var(--shadow-md);
  }
</style>
