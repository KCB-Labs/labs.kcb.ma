---
import TypeBadge from "../ui/TypeBadge.astro";
import StageBadge from "../ui/StageBadge.astro";
import RatingDots from "../ui/RatingDots.astro";
interface Props {
  slug: string;
  title: string;
  description: string;
  type: string;
  stage: string;
  originLab?: string;
  ratingKnowledge?: number;
  ratingCreativity?: number;
  ratingBusiness?: number;
}
const { slug, title, description, type, stage, originLab, ratingKnowledge = 1, ratingCreativity = 1, ratingBusiness = 1 } = Astro.props;
---
<a href={`/explore/projects/${slug}`} class="card card--project">
  <div class="card__meta">
    <TypeBadge type={type} />
    <StageBadge stage={stage} />
  </div>
  <div class="card__title-row">
    <h3>{title}</h3>
    <RatingDots knowledge={ratingKnowledge} creativity={ratingCreativity} business={ratingBusiness} />
  </div>
  <p class="text-small">{description}</p>
  {originLab && <p class="text-metadata">Origin: {originLab}</p>}
</a>

<style>
  .card--project {
    display: grid;
    gap: var(--space-3);
    padding: var(--s-gap);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--project:hover {
    border-color: var(--color-accent);
  }
  .card__meta {
    display: flex;
    gap: var(--space-2);
  }
  .card__title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .card__title-row h3 {
    margin: 0;
  }
</style>
