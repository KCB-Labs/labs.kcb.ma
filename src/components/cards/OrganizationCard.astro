---
interface Props {
  slug: string;
  name: string;
  type?: string;
}
const { slug, name, type } = Astro.props;
---
<a href={`/about/ecosystem/${slug}`} class="card card--org">
  <p style="font-weight: var(--weight-medium);">{name}</p>
  {type && <p class="text-small">{type}</p>}
</a>

<style>
  .card--org {
    display: grid;
    gap: var(--space-2);
    padding: var(--s-gap);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--org:hover {
    border-color: var(--color-accent);
  }
</style>
