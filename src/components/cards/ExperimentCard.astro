---
import RatingDots from "../ui/RatingDots.astro";
interface Props {
  slug: string;
  title: string;
  description: string;
  outcome?: string;
  ratingKnowledge?: number;
  ratingCreativity?: number;
  ratingBusiness?: number;
}
const { slug, title, description, outcome, ratingKnowledge = 1, ratingCreativity = 1, ratingBusiness = 1 } = Astro.props;
---
<a href={`/explore/experiments/${slug}`} class="card card--experiment">
  <p class="text-metadata">Experiment {outcome && `· ${outcome}`}</p>
  <div class="card__title-row">
    <h3>{title}</h3>
    <RatingDots knowledge={ratingKnowledge} creativity={ratingCreativity} business={ratingBusiness} />
  </div>
  <p class="text-small">{description}</p>
</a>

<style>
  .card--experiment {
    display: grid;
    gap: var(--space-3);
    padding: var(--s-gap);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--experiment:hover {
    border-color: var(--color-accent);
  }
  .card__title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .card__title-row h3 {
    margin: 0;
  }
</style>
