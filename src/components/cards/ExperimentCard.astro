---
import RatingDots from "../ui/RatingDots.astro";
interface Props {
  slug: string;
  title: string;
  description: string;
  outcome?: string;
  ratingKnowledge?: number;
  ratingCreativity?: number;
  ratingBusiness?: number;
}
const { slug, title, description, outcome, ratingKnowledge = 1, ratingCreativity = 1, ratingBusiness = 1 } = Astro.props;
---
<a href={`/explore/experiments/${slug}`} class="card card--experiment">
  <p class="card__meta">Experiment {outcome && `· ${outcome}`}</p>
  <h3>{title}</h3>
  <p class="card__desc">{description}</p>
  <div class="card__metrics">
    <RatingDots knowledge={ratingKnowledge} creativity={ratingCreativity} business={ratingBusiness} />
  </div>
</a>

<style>
  .card--experiment {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-duration) var(--motion-ease);
  }
  .card--experiment:hover {
    border-color: var(--color-text);
  }
  .card__meta {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin: 0;
    text-transform: uppercase;
  }
  .card--experiment h3 {
    font-family: var(--font-body);
    font-size: 21px;
    font-weight: 800;
    margin: 0;
  }
  .card__desc {
    margin: 0;
    font-size: 14.5px;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .card__metrics {
    margin-top: auto;
  }
</style>
