---
/**
 * RichContent renders Markdoc/Markdown content with editorial styling.
 * Expects frontmatter already processed, content is already rendered HTML or Markdown.
 * For full Markdoc support, use Astro's <Content /> in .astro pages.
 * This component is a placeholder for future Markdoc integration.
 */
interface Props {
  content: string;
}
const { content } = Astro.props;
---
<div class="rich-content" set:html={content} />

<style>
  .rich-content {
    max-width: var(--container-content);
  }
  .rich-content :where(h1, h2, h3) {
    color: var(--color-text-strong);
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .rich-content :where(p) {
    margin-bottom: var(--space-4);
    line-height: var(--leading-body);
  }
  .rich-content :where(ul, ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }
  .rich-content :where(blockquote) {
    border-left: 2px solid var(--color-border-strong);
    padding-left: var(--space-4);
    color: var(--color-muted-strong);
    font-style: italic;
    margin: var(--space-4) 0;
  }
  .rich-content :where(code) {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    background: var(--color-surface);
    border: var(--border-subtle);
    padding: 0.15em 0.35em;
    border-radius: var(--radius-sm);
  }
  .rich-content :where(pre) {
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow: auto;
    margin-bottom: var(--space-4);
  }
  .rich-content :where(pre code) {
    background: transparent;
    border: none;
    padding: 0;
  }
  .rich-content :where(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rich-content :where(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-4);
  }
  .rich-content :where(th, td) {
    border: var(--border-subtle);
    padding: var(--space-2) var(--space-3);
    text-align: left;
  }
  .rich-content :where(th) {
    background: var(--color-surface);
    font-weight: var(--weight-medium);
  }
  .rich-content :where(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
</style>