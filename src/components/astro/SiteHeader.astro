---
import Container from "./Container.astro";

const { pathname } = Astro.url;

function isActive(path: string): boolean {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
}

const exploreLinks = [
  { href: "/explore/labs", label: "Labs" },
  { href: "/explore/projects", label: "Projects" },
  { href: "/explore/open-source", label: "Open Source" },
];
const aboutLinks = [
  { href: "/about/vision", label: "Vision" },
  { href: "/about/people", label: "People" },
  { href: "/about/ecosystem", label: "Ecosystem" },
  { href: "/about/roadmap", label: "Roadmap" },
];
const participateLinks = [
  { href: "/participate/sponsorship", label: "Sponsorship" },
  { href: "/participate/collaboration", label: "Collaboration" },
];
---
<header class="site-header">
  <Container>
    <nav class="nav" aria-label="Primary">
      <a href="/" class="brand" aria-label="KCB Labs — Home">
        <img src="/kcb-labs-logo.png" alt="KCB Labs" class="logo" width="180" height="40" />
      </a>

      <div class="links">
        <div class="group">
          <a href="/explore" class:list={["nav-link", { "nav-link--active": isActive("/explore") }]}>Explore</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-explore" aria-label="Explore submenu">▾</button>
          <div class="dropdown" id="dropdown-explore" role="group" aria-label="Explore submenu">
            {exploreLinks.map((link) => (
              <a href={link.href} class:list={["dropdown-link", { "dropdown-link--active": isActive(link.href) }]}>{link.label}</a>
            ))}
          </div>
        </div>
        <a href="/journal" class:list={["nav-link", { "nav-link--active": isActive("/journal") }]}>Journal</a>
        <div class="group">
          <a href="/about" class:list={["nav-link", { "nav-link--active": isActive("/about") && !aboutLinks.some((l) => isActive(l.href)) }]}>About</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-about" aria-label="About submenu">▾</button>
          <div class="dropdown" id="dropdown-about" role="group" aria-label="About submenu">
            {aboutLinks.map((link) => (
              <a href={link.href} class:list={["dropdown-link", { "dropdown-link--active": isActive(link.href) }]}>{link.label}</a>
            ))}
          </div>
        </div>
        <div class="group">
          <a href="/participate" class:list={["nav-link", { "nav-link--active": isActive("/participate") && !participateLinks.some((l) => isActive(l.href)) }]}>Participate</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-participate" aria-label="Participate submenu">▾</button>
          <div class="dropdown" id="dropdown-participate" role="group" aria-label="Participate submenu">
            {participateLinks.map((link) => (
              <a href={link.href} class:list={["dropdown-link", { "dropdown-link--active": isActive(link.href) }]}>{link.label}</a>
            ))}
          </div>
        </div>
        <a href="/contact" class:list={["nav-link", { "nav-link--active": isActive("/contact") }]}>Contact</a>
      </div>

      <details class="mobile-menu">
        <summary aria-label="Open navigation" class="mobile-menu-toggle">
          <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav class="mobile-links" aria-label="Mobile">
          <details class="mobile-group">
            <summary class:list={["mobile-parent", { "mobile-parent--active": isActive("/explore") }]}>
              Explore
              <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mobile-children">
              {exploreLinks.map((link) => (
                <a href={link.href} class:list={["mobile-child", { "mobile-child--active": isActive(link.href) }]}>{link.label}</a>
              ))}
            </div>
          </details>
          <a href="/journal" class:list={["mobile-link", { "mobile-link--active": isActive("/journal") }]}>Journal</a>
          <details class="mobile-group">
            <summary class:list={["mobile-parent", { "mobile-parent--active": isActive("/about") }]}>
              About
              <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mobile-children">
              {aboutLinks.map((link) => (
                <a href={link.href} class:list={["mobile-child", { "mobile-child--active": isActive(link.href) }]}>{link.label}</a>
              ))}
            </div>
          </details>
          <details class="mobile-group">
            <summary class:list={["mobile-parent", { "mobile-parent--active": isActive("/participate") }]}>
              Participate
              <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mobile-children">
              {participateLinks.map((link) => (
                <a href={link.href} class:list={["mobile-child", { "mobile-child--active": isActive(link.href) }]}>{link.label}</a>
              ))}
            </div>
          </details>
          <a href="/contact" class:list={["mobile-link", { "mobile-link--active": isActive("/contact") }]}>Contact</a>
        </nav>
      </details>
    </nav>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: var(--border-subtle);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-gap) 0;
    gap: var(--space-6);
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo {
    height: 28px;
    width: auto;
    mix-blend-mode: multiply;
  }

  /* Desktop links */
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-body);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .links a {
    text-decoration: none;
    color: var(--color-text);
  }
  .links a:hover {
    color: var(--color-accent);
  }
  .nav-link {
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }
  .nav-link--active {
    color: var(--color-accent);
  }

  /* Desktop dropdown */
  .group {
    position: relative;
  }
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12rem;
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    flex-direction: column;
    gap: var(--space-1);
  }
  .group:hover .dropdown,
  .group:focus-within .dropdown,
  .group.open .dropdown {
    display: flex;
  }
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    vertical-align: middle;
    margin-left: -0.25em;
    transition: color var(--motion-duration) var(--motion-ease);
  }
  .dropdown-toggle:hover {
    color: var(--color-accent);
  }
  .dropdown-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .dropdown-link {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-decoration: none;
  }
  .dropdown-link:hover {
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .dropdown-link--active {
    color: var(--color-accent);
  }

  /* Mobile menu */
  .mobile-menu-toggle {
    list-style: none;
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border: none;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }
  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }
  .hamburger-icon {
    color: var(--color-text);
  }

  .mobile-menu[open] .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--space-2);
    position: absolute;
    top: 100%;
    right: var(--space-4);
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    min-width: 14rem;
    z-index: var(--z-overlay);
  }
  .mobile-links {
    display: none;
  }

  /* Mobile hierarchy - unified style for all first-level items */
  .mobile-group {
    /* no divider */
  }
  .mobile-parent,
  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-2);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    text-decoration: none;
  }
  .mobile-parent::-webkit-details-marker,
  .mobile-link::-webkit-details-marker {
    display: none;
  }
  .mobile-parent::marker,
  .mobile-link::marker {
    content: "";
  }
  .mobile-parent--active,
  .mobile-link--active {
    color: var(--color-accent);
  }
  .dropdown-icon {
    flex-shrink: 0;
    margin-left: var(--space-2);
    color: var(--color-muted);
    transition: transform var(--motion-duration-fast) var(--motion-ease);
  }
  .mobile-group[open] .dropdown-icon {
    transform: rotate(180deg);
  }
  .mobile-children {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0 0 0 var(--space-2);
    background: transparent;
    border: none;
    border-left: 2px solid var(--color-border);
  }
  .mobile-child {
    display: block;
    padding: var(--space-2) var(--space-2);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-decoration: none;
    border: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }
  .mobile-child:hover {
    color: var(--color-accent);
  }
  .mobile-child--active {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (min-width: 769px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll('.dropdown-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.group')?.classList.toggle('open', !expanded);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.dropdown-toggle[aria-expanded="true"]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.closest('.group')?.classList.remove('open');
      });
    }
  });
</script>
