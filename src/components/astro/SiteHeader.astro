---
import Container from "./Container.astro";
import { Search } from "../react/Search.tsx";
---
<header class="site-header">
  <Container>
    <nav class="nav" aria-label="Primary">
      <a href="/" class="brand" aria-label="KCB Labs — Home">
        <img src="/logo.jpg" alt="KCB" class="logo" width="120" height="40" />
        <span class="brand-text">Labs</span>
      </a>
      <div class="links">
        <div class="group">
          <a href="/explore">Explore</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-explore" aria-label="Explore submenu">▾</button>
          <div class="dropdown" id="dropdown-explore" role="group" aria-label="Explore submenu">
            <a href="/explore/labs">Labs</a>
            <a href="/explore/projects">Projects</a>
            <a href="/explore/open-source">Open Source</a>
          </div>
        </div>
        <a href="/journal">Journal</a>
        <div class="group">
          <a href="/about">About</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-about" aria-label="About submenu">▾</button>
          <div class="dropdown" id="dropdown-about" role="group" aria-label="About submenu">
            <a href="/about/vision">Vision</a>
            <a href="/about/people">People</a>
            <a href="/about/ecosystem">Ecosystem</a>
            <a href="/about/roadmap">Roadmap</a>
          </div>
        </div>
        <div class="group">
          <a href="/participate">Participate</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-participate" aria-label="Participate submenu">▾</button>
          <div class="dropdown" id="dropdown-participate" role="group" aria-label="Participate submenu">
            <a href="/participate/sponsorship">Sponsorship</a>
            <a href="/participate/collaboration">Collaboration</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
        <div class="search-wrapper">
          <Search client:visible />
        </div>
      </div>
      <details class="mobile-menu">
        <summary aria-label="Open navigation">Menu</summary>
        <nav class="mobile-links" aria-label="Mobile">
          <a href="/explore/labs">Labs</a>
          <a href="/explore/projects">Projects</a>
          <a href="/explore/open-source">Open Source</a>
          <a href="/journal">Journal</a>
          <a href="/about/vision">Vision</a>
          <a href="/about/people">People</a>
          <a href="/about/ecosystem">Ecosystem</a>
          <a href="/about/roadmap">Roadmap</a>
          <a href="/participate/sponsorship">Sponsorship</a>
          <a href="/participate/collaboration">Collaboration</a>
          <a href="/contact">Contact</a>
        </nav>
      </details>
    </nav>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-surface);
    border-bottom: var(--border-subtle);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem; /* layout-specific: 56px header height (between --space-7 and --space-8) */
    gap: var(--space-6);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }
  .logo {
    height: 32px;
    width: auto;
    mix-blend-mode: multiply;
  }
  .brand-text {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-strong);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-size: var(--text-small);
  }
  .links a {
    text-decoration: none;
    color: var(--color-muted-strong);
  }
  .links a:hover {
    color: var(--color-text);
  }
  .group {
    position: relative;
  }
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12rem; /* layout-specific: dropdown min width */
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    flex-direction: column;
    gap: var(--space-1);
  }
  .group:hover .dropdown,
  .group:focus-within .dropdown,
  .group.open .dropdown {
    display: flex;
  }
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    color: var(--color-muted-strong);
    cursor: pointer;
    font-size: var(--text-small);
    padding: 0;
    line-height: 1;
    transition: color var(--motion-duration) var(--motion-ease);
  }
  .dropdown-toggle:hover {
    color: var(--color-text);
  }
  .dropdown-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .dropdown a {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
  .dropdown a:hover {
    background: var(--color-bg);
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border: var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
  }
  .mobile-menu[open] .mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    position: absolute;
    top: 100%;
    right: var(--space-4);
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    min-width: 14rem;
    z-index: var(--z-overlay);
  }
  .mobile-links {
    display: none;
  }
  @media (max-width: 768px) { /* --breakpoint-md, var() not valid in @media */
    .links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (min-width: 769px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll('.dropdown-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.group')?.classList.toggle('open', !expanded);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.dropdown-toggle[aria-expanded="true"]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.closest('.group')?.classList.remove('open');
      });
    }
  });
</script>
