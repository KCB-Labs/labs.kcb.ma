---
import Container from "./Container.astro";

const { pathname } = Astro.url;

function isActive(path: string): boolean {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
}

const exploreLinks = [
  { href: "/explore/labs", label: "Labs" },
  { href: "/explore/projects", label: "Projects" },
  { href: "/explore/open-source", label: "Open Source" },
];
const aboutLinks = [
  { href: "/about/vision", label: "Vision" },
  { href: "/about/people", label: "People" },
  { href: "/about/ecosystem", label: "Ecosystem" },
  { href: "/about/roadmap", label: "Roadmap" },
];
const participateLinks = [
  { href: "/participate/sponsorship", label: "Sponsorship" },
  { href: "/participate/collaboration", label: "Collaboration" },
];
---
<header class="site-header">
  <Container>
    <nav class="nav" aria-label="Primary">
      <a href="/" class="brand" aria-label="KCB Labs — Home">
        <img src="/kcb-labs-logo.png" alt="KCB Labs" class="logo" width="180" height="40" />
      </a>

      <div class="links">
        <div class="group">
          <a href="/explore" class:list={["nav-link", { "nav-link--active": isActive("/explore") }]}>Explore</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-explore" aria-label="Explore submenu">▾</button>
          <div class="dropdown" id="dropdown-explore" role="group" aria-label="Explore submenu">
            {exploreLinks.map((link) => (
              <a href={link.href} class:list={["dropdown-link", { "dropdown-link--active": isActive(link.href) }]}>{link.label}</a>
            ))}
          </div>
        </div>
        <a href="/journal" class:list={["nav-link", { "nav-link--active": isActive("/journal") }]}>Journal</a>
        <div class="group">
          <a href="/about" class:list={["nav-link", { "nav-link--active": isActive("/about") && !aboutLinks.some((l) => isActive(l.href)) }]}>About</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-about" aria-label="About submenu">▾</button>
          <div class="dropdown" id="dropdown-about" role="group" aria-label="About submenu">
            {aboutLinks.map((link) => (
              <a href={link.href} class:list={["dropdown-link", { "dropdown-link--active": isActive(link.href) }]}>{link.label}</a>
            ))}
          </div>
        </div>
        <div class="group">
          <a href="/participate" class:list={["nav-link", { "nav-link--active": isActive("/participate") && !participateLinks.some((l) => isActive(l.href)) }]}>Participate</a>
          <button class="dropdown-toggle" aria-expanded="false" aria-controls="dropdown-participate" aria-label="Participate submenu">▾</button>
          <div class="dropdown" id="dropdown-participate" role="group" aria-label="Participate submenu">
            {participateLinks.map((link) => (
              <a href={link.href} class:list={["dropdown-link", { "dropdown-link--active": isActive(link.href) }]}>{link.label}</a>
            ))}
          </div>
        </div>
        <a href="/contact" class:list={["nav-link", { "nav-link--active": isActive("/contact") }]}>Contact</a>
      </div>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">Menu</summary>
        <nav class="mobile-links" aria-label="Mobile">
          <details class="mobile-group">
            <summary class:list={["mobile-parent", { "mobile-parent--active": isActive("/explore") }]}>Explore</summary>
            <div class="mobile-children">
              {exploreLinks.map((link) => (
                <a href={link.href} class:list={["mobile-child", { "mobile-child--active": isActive(link.href) }]}>{link.label}</a>
              ))}
            </div>
          </details>
          <a href="/journal" class:list={["mobile-parent", { "mobile-parent--active": isActive("/journal") }]}>Journal</a>
          <details class="mobile-group">
            <summary class:list={["mobile-parent", { "mobile-parent--active": isActive("/about") }]}>About</summary>
            <div class="mobile-children">
              {aboutLinks.map((link) => (
                <a href={link.href} class:list={["mobile-child", { "mobile-child--active": isActive(link.href) }]}>{link.label}</a>
              ))}
            </div>
          </details>
          <details class="mobile-group">
            <summary class:list={["mobile-parent", { "mobile-parent--active": isActive("/participate") }]}>Participate</summary>
            <div class="mobile-children">
              {participateLinks.map((link) => (
                <a href={link.href} class:list={["mobile-child", { "mobile-child--active": isActive(link.href) }]}>{link.label}</a>
              ))}
            </div>
          </details>
          <a href="/contact" class:list={["mobile-parent", { "mobile-parent--active": isActive("/contact") }]}>Contact</a>
        </nav>
      </details>
    </nav>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: var(--border-subtle);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) 0;
    gap: var(--space-6);
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo {
    height: 40px;
    width: auto;
    mix-blend-mode: multiply;
  }

  /* Desktop links */
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-size: var(--text-small);
  }
  .links a {
    text-decoration: none;
    color: var(--color-muted-strong);
  }
  .links a:hover {
    color: var(--color-text);
  }
  .nav-link {
    padding-bottom: 2px solid transparent;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }
  .nav-link--active {
    color: var(--color-text);
    border-bottom: 2px solid var(--color-accent);
  }

  /* Desktop dropdown */
  .group {
    position: relative;
  }
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12rem;
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    flex-direction: column;
    gap: var(--space-1);
  }
  .group:hover .dropdown,
  .group:focus-within .dropdown,
  .group.open .dropdown {
    display: flex;
  }
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    color: var(--color-muted-strong);
    cursor: pointer;
    font-size: var(--text-small);
    padding: 0;
    line-height: 1;
    transition: color var(--motion-duration) var(--motion-ease);
  }
  .dropdown-toggle:hover {
    color: var(--color-text);
  }
  .dropdown-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .dropdown-link {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
  .dropdown-link:hover {
    background: var(--color-bg);
  }
  .dropdown-link--active {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border: var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
  }
  .mobile-menu[open] .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--space-2);
    position: absolute;
    top: 100%;
    right: var(--space-4);
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    min-width: 14rem;
    z-index: var(--z-overlay);
  }
  .mobile-links {
    display: none;
  }

  /* Mobile hierarchy */
  .mobile-group {
    border-bottom: var(--border-subtle);
  }
  .mobile-group:last-child {
    border-bottom: none;
  }
  .mobile-parent {
    display: block;
    padding: var(--space-2) var(--space-2);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .mobile-parent::-webkit-details-marker {
    display: none;
  }
  .mobile-parent::marker {
    content: "";
  }
  .mobile-parent--active {
    color: var(--color-accent);
  }
  .mobile-children {
    display: flex;
    flex-direction: column;
    padding-left: var(--space-3);
    padding-bottom: var(--space-1);
  }
  .mobile-child {
    display: block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-small);
    color: var(--color-muted);
    text-decoration: none;
    border-left: 2px solid var(--color-border);
  }
  .mobile-child:hover {
    color: var(--color-text);
    background: var(--color-bg);
  }
  .mobile-child--active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (min-width: 769px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll('.dropdown-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.closest('.group')?.classList.toggle('open', !expanded);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.dropdown-toggle[aria-expanded="true"]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.closest('.group')?.classList.remove('open');
      });
    }
  });
</script>
