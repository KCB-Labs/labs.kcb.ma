---
import Container from "./Container.astro";
import { Search } from "../react/Search.tsx";

const { pathname } = Astro.url;

function isActive(path: string): boolean {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
}

const navLinks = [
  { href: "/explore/labs", label: "Labs" },
  { href: "/explore/projects", label: "Projects" },
  { href: "/journal", label: "Journal" },
  { href: "/about", label: "About" },
  { href: "/participate", label: "Participate" },
];

const mobileLinks = [
  { href: "/explore", label: "Explore" },
  { href: "/explore/labs", label: "Labs" },
  { href: "/explore/projects", label: "Projects" },
  { href: "/explore/open-source", label: "Open Source" },
  { href: "/journal", label: "Journal" },
  { href: "/about", label: "About" },
  { href: "/about/vision", label: "Vision" },
  { href: "/about/people", label: "People" },
  { href: "/about/ecosystem", label: "Ecosystem" },
  { href: "/about/roadmap", label: "Roadmap" },
  { href: "/participate", label: "Participate" },
  { href: "/participate/sponsorship", label: "Sponsorship" },
  { href: "/participate/collaboration", label: "Collaboration" },
  { href: "/contact", label: "Contact" },
];
---
<header class="site-header">
  <Container>
    <a href="/" class="site-logo" aria-label="KCB Labs — Home">
      <span class="logo-icon">🔬</span>
      <span class="logo-text">KCB<span class="logo-suffix">.labs</span></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" hidden />
    <label for="nav-toggle" class="hamburger" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="nav-links" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class:list={["nav-link", { "nav-link--active": isActive(link.href) }]}>{link.label}</a>
      ))}
      <Search client:visible />
    </nav>

    <nav class="mobile-links" aria-label="Mobile">
      {mobileLinks.map((link) => (
        <a href={link.href} class:list={["mobile-link", { "mobile-link--active": isActive(link.href) }]}>{link.label}</a>
      ))}
    </nav>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: var(--border-subtle);
  }
  .site-header :global(.container) {
    display: flex;
    align-items: center;
    height: 3rem;
    gap: var(--space-6);
  }

  /* Logo — matches asdlc.io brand-mark style */
  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-icon {
    font-size: 1.25rem;
    line-height: 1;
  }
  .logo-text {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--color-text-strong);
    letter-spacing: -0.02em;
  }
  .logo-suffix {
    color: var(--color-muted);
  }

  /* Hamburger — same checkbox hack as asdlc.io */
  .nav-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 24px;
    height: 24px;
    cursor: pointer;
    margin-left: auto;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    transition: transform var(--motion-duration-fast) var(--motion-ease);
  }
  .nav-toggle:checked ~ .hamburger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle:checked ~ .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle:checked ~ .hamburger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Desktop nav — flat links, no dropdowns */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-left: auto;
  }
  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--color-text);
  }
  .nav-link--active {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* Mobile nav */
  .mobile-links {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .hamburger {
      display: flex;
    }
    .nav-toggle:checked ~ .mobile-links {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: var(--border-subtle);
      padding: var(--space-3) var(--space-4);
      gap: 0;
      z-index: var(--z-overlay);
    }
    .mobile-link {
      display: block;
      padding: var(--space-2) 0;
      font-size: var(--text-small);
      color: var(--color-muted);
      text-decoration: none;
      border-bottom: var(--border-subtle);
    }
    .mobile-link:last-child {
      border-bottom: none;
    }
    .mobile-link:hover {
      color: var(--color-text);
    }
    .mobile-link--active {
      color: var(--color-accent);
      font-weight: var(--weight-medium);
    }
  }
  @media (min-width: 769px) {
    .hamburger {
      display: none !important;
    }
    .mobile-links {
      display: none !important;
    }
  }
</style>
