---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {crumbs.map((crumb, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: var(--text-metadata);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-block: var(--space-6) var(--space-2);
    border-bottom: var(--border-subtle);
    margin-bottom: var(--space-2);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
  }
  .breadcrumbs .sep {
    margin: 0 var(--space-1);
    opacity: 0.5;
  }
  .breadcrumbs a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }
  .breadcrumbs a:hover {
    color: var(--color-accent);
  }
  .breadcrumbs span[aria-current="page"] {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
</style>
