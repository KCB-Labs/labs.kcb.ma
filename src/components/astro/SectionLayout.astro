---
import Breadcrumb from "./Breadcrumb.astro";
import SectionSidebar from "./SectionSidebar.astro";

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
  title: string;
  description?: string;
  status?: string;
  section: "explore" | "about" | "participate";
  currentSlug: string;
}
const { crumbs, title, description, status, section, currentSlug } = Astro.props;
---

<div class="section-layout">
  <Breadcrumb crumbs={crumbs} />

  <div class="section-layout__body">
    <aside class="section-layout__sidebar">
      <SectionSidebar section={section} currentSlug={currentSlug} />
    </aside>

    <div class="section-layout__main">
      <header class="section-layout__header">
        <div class="section-layout__title-row">
          <h1>{title}</h1>
          {Astro.slots.has("rating") && <span class="section-layout__rating"><slot name="rating" /></span>}
        </div>
        {description && <p class="section-layout__description">{description}</p>}
        {status && <p class="section-layout__status">{status}</p>}
      </header>

      <div class="section-layout__content">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .section-layout {
    padding-top: var(--space-5);
  }

  .section-layout__body {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 56px;
    align-items: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-5);
  }
  .section-layout__sidebar {
    padding-top: 6px;
  }

  /* Header — inside content column */
  .section-layout__header {
    padding-bottom: var(--space-5);
  }
  .section-layout__header h1 {
    margin: 0 0 var(--space-3);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .section-layout__title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .section-layout__description {
    font-size: 17px;
    color: var(--color-muted);
    max-width: 640px;
    line-height: 1.55;
    margin: 0 0 var(--space-5);
  }
  .section-layout__status {
    font-family: var(--font-body);
    font-size: var(--text-metadata);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: var(--space-2);
  }

  /* Divider between header and content */
  .section-layout__content {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }

  @media (max-width: 900px) {
    .section-layout__body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .section-layout__sidebar {
      position: static;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .section-layout__sidebar :global(.section-sidebar ul) {
      flex-direction: row;
      gap: var(--space-2);
    }
    .section-layout__sidebar :global(.section-sidebar__link) {
      border-left: none;
      border-bottom: 3px solid transparent;
      white-space: nowrap;
    }
    .section-layout__sidebar :global(.section-sidebar__link--active) {
      border-bottom-color: var(--color-accent);
    }
  }
</style>
