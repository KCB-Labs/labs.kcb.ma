---
interface Props {
  label?: string;
  title: string;
  description?: string;
  status?: string;
}
const { label, title, description, status } = Astro.props;
---
<header class="page-header">
  {label && <p class="text-metadata">{label}</p>}
  <h1>{title}</h1>
  {description && <p class="text-body" style="color: var(--color-muted); max-width: var(--container-content);">{description}</p>}
  {status && <p class="text-metadata" style="margin-top: var(--space-2);">{status}</p>}
</header>

<style>
  .page-header {
    padding-block: var(--space-6);
    border-bottom: var(--border-subtle);
    margin-bottom: var(--space-6);
  }
  .page-header h1 {
    margin-top: var(--space-2);
  }
</style>
