# KCB Labs — Environment Variables
# Copy to .env for local development or set in Coolify

# ─── Keystatic GitHub Mode (Production) ───
# When these are set, Keystatic uses GitHub storage with OAuth.
# When unset, Keystatic falls back to local file storage (dev mode).

# GitHub repo for Keystatic content (format: owner/repo)
KEYSTATIC_GITHUB_REPO=kcb-labs/labs.kcb.ma

# GitHub OAuth App credentials (created via Keystatic UI on first visit)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Secret for Keystatic session encryption (generate a random string)
KEYSTATIC_SECRET=

# GitHub App slug (public, used by Keystatic UI)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ─── Skip Keystatic (optional) ───
# Set to "true" to disable Keystatic routes entirely (e.g., static-only deploys)
# SKIP_KEYSTATIC=true

# ─── Site ───
PUBLIC_SITE_URL=https://labs.kcb.ma
